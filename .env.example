# 本地开发口令，可自行修改；仅监听本机，不要直接公开部署。
ADMIN_SECRET=xiaosu-local-dev
# 留空即自动创建 data/xiaosu.sqlite3，无需数据库服务。
DATABASE_URL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 千问最终回答的深度思考开关；工具选择阶段固定关闭。
LLM_ENABLE_THINKING=false
# 语义检索必须配置真实 Embedding 模型，SQLite 存储模型向量。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
ALLOWED_MODELS=
PUBLIC_BASE_URL=http://localhost:8000
MOCK_API_URL=http://127.0.0.1:8001
MAX_UPLOAD_MB=20
MAX_TOOL_ROUNDS=5
REQUEST_TIMEOUT=90
RETRIEVAL_MIN_SCORE=0.45
# 后续 IM 接入时再填。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# AI 卡片模板 ID；留空时仍发送完整 Markdown 消息。模板流式字段需为 content。
DINGTALK_CARD_TEMPLATE_ID=
